{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7aa1671c-426b-4f3c-b168-734086479b28","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a5bd0abd3e6341778cdda951b5fb5721" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
